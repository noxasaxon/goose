{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Goose desktop application permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-create",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "dialog:default",
    "shell:default",
    "shell:allow-open",
    "process:default",
    "process:allow-exit",
    "notification:default",
    "deep-link:default",
    "updater:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/goosed",
          "sidecar": true,
          "args": {
            "args": ["agent"]
          }
        }
      ]
    }
  ]
}
