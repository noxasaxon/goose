{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goose",
  "version": "1.0.30",
  "identifier": "com.goose.app",
  "build": {
    "frontendDist": "../desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../desktop && npm run dev:vite",
    "beforeBuildCommand": "cd ../desktop && npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Goose",
        "width": 750,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "minWidth": 600,
        "minHeight": 400,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/goosed"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/block/goose/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMkJCOTJCQzFGOEY5RUMKUldRWTRQUHpBdTVJM1NhcTFPQWdYdGJJWnhQUGVNb0t2eGp2U0FZWENKdHhGSmIvQXdKMElMcysK"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "goose"
        ]
      }
    }
  }
}